#include <physical_layouts.dtsi>

/ {
    physical_layout_studiopad: physical_layout_studiopad {
        compatible = "zmk,physical-layout";
        display-name = "StudioPad";
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0  225       0     0   225>
            , <&key_physical_attrs 100 100  100  200       0   100   200>
            , <&key_physical_attrs 100 100  200  225       0   200   225>
            , <&key_physical_attrs  50  50  400  300       0   400   300>
            , <&key_physical_attrs  50  50    0    0       0     0     0>
            , <&key_physical_attrs 100 100    0  325       0     0   325>
            , <&key_physical_attrs 100 100  100  300       0   100   300>
            , <&key_physical_attrs 100 100  200  325       0   200   325>
            , <&key_physical_attrs  50  50  450  250       0   450   250>
            , <&key_physical_attrs  50  50   50    0       0    50     0>
            , <&key_physical_attrs  50  50    0   75       0     0    75>
            , <&key_physical_attrs  50  50   50   75       0    50    75>
            , <&key_physical_attrs  50  50  100   75       0   100    75>
            , <&key_physical_attrs  50  50  400  200       0   400   200>
            , <&key_physical_attrs  50  50  100    0       0   100     0>
            , <&key_physical_attrs  50  50  150   75       0   150    75>
            , <&key_physical_attrs  50  50  200   75       0   200    75>
            , <&key_physical_attrs  50  50  250   75       0   250    75>
            , <&key_physical_attrs  50  50  350  250       0   350   250>
            , <&key_physical_attrs  50  50  150    0       0   150     0>
            , <&key_physical_attrs  50  50  300   75       0   300    75>
            , <&key_physical_attrs  50  50  350   75       0   350    75>
            , <&key_physical_attrs  50  50  400   75       0   400    75>
            , <&key_physical_attrs  50  50  400  375       0   400   375>
            , <&key_physical_attrs  50  50  325  375       0   325   375>
            , <&key_physical_attrs  50  50  225  150       0   225   150>
            , <&key_physical_attrs  50  50   25  150       0    25   150>
            , <&key_physical_attrs  50  50  475  375       0   475   375>
            ;
    };
};
